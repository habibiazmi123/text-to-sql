{"nodes": [{"id": "docs_superpowers_specs_2026_08_12_phase3_business_rules_rag_design_business_knowledge_rag", "label": "Business Knowledge RAG", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-phase3-business-rules-rag-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users ask questions like 'Berapa revenue bulan lalu?' and the system retrieves the relevant Revenue business rule so the LLM generates SQL consistent with the business definition instead of guessing from column names."}, {"id": "docs_superpowers_specs_2026_08_12_phase3_business_rules_rag_design_business_rules_retriever", "label": "Business Rules Retriever (retrieve_relevant_rules)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-12-phase3-business-rules-rag-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_12_phase3_business_rules_rag_design_business_rules_indexer", "label": "Business Rules Indexer (index_business_rules)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-12-phase3-business-rules-rag-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "embeds 'term: definition' for each rule so retrieval can match rules semantically."}, {"id": "docs_superpowers_specs_2026_08_12_phase3_business_rules_rag_design_schema_rag", "label": "Schema RAG (existing)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-phase3-business-rules-rag-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_12_phase3_business_rules_rag_design_hybrid_retrieval_strategy", "label": "Hybrid Retrieval Strategy (pqgvector + ILIKE)", "file_type": "rationale", "source_file": "docs/superp